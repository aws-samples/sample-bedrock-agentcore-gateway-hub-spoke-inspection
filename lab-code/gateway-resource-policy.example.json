 {"Sid":"AllowOnlyViaHubVpce","Effect":"Allow","Principal":"*","Action":"bedrock-agentcore:InvokeGateway","Resource":"arn:aws:bedrock-agentcore:us-east-1:<agentcore-account-id>:gateway/<gateway-id>","Condition":{"StringEquals":{"aws:SourceVpce":"<gateway-vpce-id>"}}},
